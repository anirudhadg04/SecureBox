# SecureBox Environment Configuration Template
# Copy this file to .env for local development

# Server network settings
PORT=3001
NODE_ENV=development

# Session secret (min 32 random bytes in hex or base64)
SESSION_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Vault storage directory path
VAULT_STORAGE_DIR=./data/vault_storage

# SQLite database file path
DATABASE_PATH=./data/securebox.db

# Storage quota per user in bytes (default 100 MB = 104857600)
USER_STORAGE_QUOTA_BYTES=104857600

# Client origin for CORS
CLIENT_ORIGIN=http://localhost:3000
